# 本番・ステージングのBackendサービスへ登録する環境変数
# ローカルDocker Composeでは使用しない
APP_ENV=prod
APP_PORT=8080
# デプロイ前にリポジトリルートで `make migrate` を実行

DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Clerk Secret Key（本番用）
CLERK_SECRET_KEY=

FRONTEND_BASE_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com,https://auth.example.com,https://admin.example.com,https://help.example.com,https://info.example.com,https://contact.example.com
ALLOWED_ORIGIN_SUFFIXES=
COOKIE_DOMAIN=

SES_FROM_EMAIL=
SES_INVITE_TEMPLATE_PATH=
AWS_REGION=ap-northeast-1
AWS_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
